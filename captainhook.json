{
    "pre-commit": {
        "enabled": true,
        "actions": [
            {
                "action": "vendor/bin/pint ./app ./database ./tests --test"
            },
            {
                "action": "php artisan test --no-coverage"
            }
        ]
    },
    "pre-merge-commit": {
        "enabled": true,
        "actions": [
            {
                "run": "vendor/bin/captainhook run pre-commit"
            }
        ]
    }
}
