includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    bootstrapFiles:
        - vendor/larastan/larastan/bootstrap.php

    paths:
        - app/

    level: max

    ignoreErrors:
        # IDE helper classes don't exist - they're auto-generated by Laravel IDE Helper
        - '#PHPDoc tag @mixin contains unknown class App\\Models\\IdeHelper.*\.#'

    reportUnmatchedIgnoredErrors: false

    scanFiles:
        - _ide_helper_models.php

#    ignoreErrors:
#        - '#PHPDoc tag @var#'
#
#    excludePaths:
#        - ./*/*/FileToBeExcluded.php
